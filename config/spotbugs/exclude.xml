<?xml version="1.0" encoding="UTF-8"?>
<!--
  Batch 59 — filter NOISE SpotBugs untuk Vidsize (dipakai spotbugsRelease lewat spotbugs.gradle.kts).
  Diadaptasi dari config/spotbugs/exclude.xml SONIX, TAPI isinya SENGAJA MINIMAL:
  filter SONIX (EI_EXPOSE_REP, BC_BAD_CAST_*, dst.) berdasar bukti laporan run SONIX + pembacaan kode di tiap titik
  temuan SONIX. Vidsize belum punya satu pun laporan run -> menyaring kategori yang sama tanpa bukti = menyembunyikan
  temuan yang belum terverifikasi. Aturan: tambah filter HANYA setelah laporan CI Vidsize ada + kode di titik temuan
  dibaca dan terbukti artefak bytecode Kotlin/Compose (cantumkan run + alasan per baris di komentar ini, sempit:
  per file/kelas). Daftar SpotBugs di laporan memuat SEMUA temuan non-filter (maks 120 titik), jadi filter bisa diaudit dari laporan.

  Disaring sekarang (terbukti bukan kode proyek / bukan bug, tanpa perlu data run):
  - NM_METHOD_NAMING_CONVENTION: fungsi @Composable WAJIB berawalan huruf besar (pedoman API Compose) — aturan
    penamaan, bukan cacat; tak ada perbaikan yang valid.
  - Kelas hasil generate: ComposableSingletons (Compose compiler), R, BuildConfig — bukan kode proyek.
  - Batch 63 (bukti laporan run #4): sumber `LazyDsl.kt` — EI_EXPOSE_REP2 x51 (LazyDsl.kt:0) dan
    NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE x17 (LazyDsl.kt:149). Berkas `LazyDsl.kt` TIDAK ada di pohon
    sumber proyek (find = kosong); itu fungsi `inline` Compose Foundation (LazyListScope.items dst.) yang tubuhnya
    disalin kompilator Kotlin ke kelas sintetis proyek, jadi tak ada yang bisa diperbaiki di kode proyek. Disaring
    HANYA lewat nama sumber `LazyDsl.kt`; temuan `MainActivity.kt`/`VideoPickerScreen.kt` (termasuk baris :0) TIDAK disaring.
  - Batch 65 (bukti laporan run #6): NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE hanya pada MainActivity.kt (82 titik: 51 di
    baris :0 + 31 baris), VideoPickerScreen.kt (10) dan ui/theme/Theme.kt (1). Setiap titik BERBARIS (kode dibaca, Batch 65) adalah situs
    pemanggilan/komposisi Compose (`Column(`, `IconButton(`, `HomeToolCard(`, `remember(`, `LocalContext.current`, blok `if`/`when` berisi
    composable, deklarasi `) {` fungsi composable) — tempat kompilator Compose menyisipkan argumen sintetis `$composer` (@Nullable) yang
    langsung dideref. Kode Kotlin yang lolos kompilator tidak bisa menderef parameter bertipe `T?` tanpa cek, jadi pola ini tak bisa
    menandai bug nyata di sumber Kotlin; baris :0 = metode sintetis tanpa nomor baris (pola sama, tidak diperiksa bytecode-nya).
    Disaring SEMPIT: pola ini x berkas di atas. AppUpdater.kt (2 titik :0, BUKAN berkas Compose) SENGAJA tidak disaring.
-->
<FindBugsFilter>
  <Match>
    <Bug pattern="NM_METHOD_NAMING_CONVENTION"/>
  </Match>
  <Match>
    <Class name="~.*ComposableSingletons.*"/>
  </Match>
  <Match>
    <Class name="~.*\.R(\$.*)?"/>
  </Match>
  <Match>
    <Class name="~.*\.BuildConfig"/>
  </Match>
  <Match>
    <Source name="LazyDsl.kt"/>
  </Match>
  <Match>
    <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE"/>
    <Source name="MainActivity.kt"/>
  </Match>
  <Match>
    <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE"/>
    <Source name="VideoPickerScreen.kt"/>
  </Match>
  <Match>
    <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE"/>
    <Source name="Theme.kt"/>
  </Match>
</FindBugsFilter>
