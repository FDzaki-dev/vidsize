# Auto-detect text files, normalize to LF on checkin (avoids CRLF diff
# noise between Termux/Linux CI and any Windows/macOS contributor).
* text=auto eol=lf

*.kt          text eol=lf
*.kts         text eol=lf
*.xml         text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.properties  text eol=lf
*.pro         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Binary assets: never let git attempt text diff/merge/EOL conversion on
# these — corrupts keystore/APK signing bytes and image binaries.
*.keystore binary -diff -merge
*.jks      binary -diff -merge
*.apk      binary -diff -merge
*.aab      binary -diff -merge
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.ttf      binary
*.otf      binary

# release.keystore is a [PROTECTED] asset per PROJECT_STATE.md — explicit
# rule so it's never diffed/patched even if a future *.keystore pattern
# above is ever narrowed or removed by mistake.
release.keystore binary -diff -merge
